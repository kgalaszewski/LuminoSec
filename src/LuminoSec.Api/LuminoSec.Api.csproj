<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Pins the transitive Microsoft.OpenApi dependency past GHSA-v5pm-xwqc-g5wc
         (stack-overflow DoS on circular schema refs), fixed in 2.7.5+. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101.5" />
    <!-- Needed at runtime to resolve credentials for a profile chain that
         bottoms out in an `aws login` (login_session) profile. -->
    <PackageReference Include="AWSSDK.Signin" Version="4.0.101.9" />
    <!-- Needed at runtime for AssumeRoleAWSCredentials (role_arn +
         source_profile chaining) to call sts:AssumeRole. -->
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.100.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LuminoSec.Api.Tests" />
  </ItemGroup>

</Project>
